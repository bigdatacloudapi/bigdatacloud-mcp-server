{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/oauth/authorize", "destination": "/api/oauth-authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth-token" },
    { "source": "/oauth/register", "destination": "/api/oauth-register" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/wellknown-prm" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/wellknown-prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/wellknown-as" },
    { "source": "/.well-known/oauth-authorization-server/mcp", "destination": "/api/wellknown-as" }
  ],
  "functions": {
    "api/mcp.mjs": { "maxDuration": 60 },
    "api/[...slug].mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
